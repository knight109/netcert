#!/usr/bin/env python3
"""Inventory websites you own or are authorized to monitor."""

from __future__ import annotations

import argparse
import csv
import datetime as dt
import ipaddress
import json
import re
import socket
import ssl
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any


VERSION = "0.1.3"
TIMEOUT_SECONDS = 8


def build_parser() -> argparse.ArgumentParser:
	parser = argparse.ArgumentParser(
		prog="netcert",
		description=(
			"Check and inventory websites that you manage or are authorized "
			"to monitor. This is an office maintenance tool, not a "
			"vulnerability scanner."
		),
		epilog=(
			"Examples:\n"
			"  netcert --ip -u example.com\n"
			"  netcert --ip4 -u example.com\n"
			"  netcert --ip6 -u example.com\n"
			"  netcert -i -l sites.txt --ip4 --save ips.txt\n"
			"  netcert -a -l sites.txt --json\n"
			"  netcert --dns -l sites.txt --save dns.json --json\n"
			"  netcert --subdomains -u example.com --save\n"
			"  netcert --ssl -l sites.txt --store ./certificates --summary\n"
			"  netcert --status -l sites.txt --csv --save health.csv"
		),
		formatter_class=argparse.RawDescriptionHelpFormatter,
	)
	targets = parser.add_mutually_exclusive_group(required=True)
	targets.add_argument("-u", "--url", metavar="URL", help="one URL or domain")
	targets.add_argument("-l", "--list", metavar="FILE", help="file with one target per line")

	functions = parser.add_mutually_exclusive_group()
	functions.add_argument("-i", "--ip", action="store_true", help="resolve and show IPv4 and IPv6 addresses")
	functions.add_argument("-a", "--availability", action="store_true", help="check whether the website responds")
	functions.add_argument("--dns", action="store_true", help="show resolved addresses, canonical name, and PTR names")
	functions.add_argument("--subdomains", action="store_true", help="find known subdomains in public Certificate Transparency logs")
	functions.add_argument("--ssl", action="store_true", help="collect peer certificates as PEM files")
	functions.add_argument("--status", action="store_true", help="show IP, availability, and SSL health")
	parser.add_argument("--ip4", action="store_true", help="limit --ip to IPv4 (also selects IP lookup by itself)")
	parser.add_argument("--ip6", action="store_true", help="limit --ip to IPv6 (also selects IP lookup by itself)")

	parser.add_argument("--store", metavar="DIRECTORY", help="directory for collected SSL certificate files")
	parser.add_argument("--summary", action="store_true", help="write one summary.txt in the certificate directory")
	parser.add_argument(
		"--save",
		nargs="?",
		const="",
		metavar="FILE",
		help="save normal output (default filename depends on function and format)",
	)
	formats = parser.add_mutually_exclusive_group()
	formats.add_argument("--json", dest="output_format", action="store_const", const="json", help="print output as JSON")
	formats.add_argument("--csv", dest="output_format", action="store_const", const="csv", help="print output as CSV")
	parser.add_argument("-v", "--version", action="version", version=f"%(prog)s {VERSION}")
	return parser


def parse_target(value: str) -> dict[str, Any]:
	value = value.strip()
	if not value:
		raise ValueError("target is empty")
	try:
		address = ipaddress.ip_address(value)
	except ValueError:
		address = None
	if address is not None:
		return {"target": address.compressed, "host": address.compressed, "scheme": None, "port": None, "path": "/"}
	parsed = urllib.parse.urlsplit(value if "://" in value else f"//{value}")
	if parsed.scheme and parsed.scheme not in ("http", "https"):
		raise ValueError("only http and https URLs are supported")
	host = parsed.hostname
	if not host:
		raise ValueError("target must be a hostname or URL with a hostname")
	try:
		port = parsed.port
	except ValueError as exc:
		raise ValueError(f"invalid port: {exc}") from exc
	scheme = parsed.scheme.lower() if parsed.scheme else None
	path = parsed.path or "/"
	if parsed.query:
		path += f"?{parsed.query}"
	return {
		"target": host,
		"host": host.encode("idna").decode("ascii"),
		"scheme": scheme,
		"port": port,
		"path": path,
	}


def read_targets(args: argparse.Namespace) -> list[dict[str, Any]]:
	if args.url:
		lines = [args.url]
	else:
		try:
			lines = Path(args.list).read_text(encoding="utf-8").splitlines()
		except OSError as exc:
			raise ValueError(f"cannot read target list {args.list!r}: {exc}") from exc

	targets: list[dict[str, Any]] = []
	for line_number, line in enumerate(lines, start=1):
		value = line.strip()
		if not value or value.startswith("#"):
			continue
		try:
			targets.append(parse_target(value))
		except ValueError as exc:
			raise ValueError(f"invalid target on line {line_number}: {exc}") from exc
	if not targets:
		raise ValueError("no targets found")
	return targets


def resolve_addresses(host: str) -> list[str]:
	try:
		address = ipaddress.ip_address(host)
		return [address.compressed]
	except ValueError:
		pass
	records = socket.getaddrinfo(host, None, socket.AF_UNSPEC, socket.SOCK_STREAM)
	addresses = {record[4][0].split("%", 1)[0] for record in records}
	return sorted(addresses, key=lambda item: (ipaddress.ip_address(item).version, int(ipaddress.ip_address(item))))


def dns_information(host: str) -> dict[str, Any]:
	info: dict[str, Any] = {"addresses": resolve_addresses(host), "canonical_name": None, "ptr": {}}
	try:
		canonical = socket.gethostbyname_ex(host)[0]
		info["canonical_name"] = canonical if canonical != host else None
	except (OSError, socket.gaierror):
		pass
	for address in info["addresses"]:
		try:
			ptr_name = socket.gethostbyaddr(address)[0]
			if ptr_name:
				info["ptr"][address] = ptr_name
		except (OSError, socket.herror, socket.gaierror):
			continue
	return info


def find_subdomains(host: str) -> list[str]:
	base_domain = host.rstrip(".").encode("idna").decode("ascii").lower()
	try:
		ipaddress.ip_address(base_domain)
	except ValueError:
		pass
	else:
		raise ValueError("subdomain discovery requires a domain name, not an IP address")
	query = urllib.parse.urlencode({"q": f"%.{base_domain}", "output": "json"})
	url = f"https://crt.sh/?{query}"
	request = urllib.request.Request(url, headers={"User-Agent": f"netcert/{VERSION}"})
	with urllib.request.urlopen(request, timeout=TIMEOUT_SECONDS) as response:
		entries = json.loads(response.read().decode("utf-8"))
	if not isinstance(entries, list):
		raise ValueError("Certificate Transparency service returned an unexpected response")

	labels = re.compile(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\Z")
	subdomains: set[str] = set()
	for entry in entries:
		if not isinstance(entry, dict):
			continue
		name_value = entry.get("name_value")
		if not isinstance(name_value, str):
			continue
		for name in name_value.splitlines():
			candidate = name.strip().lower().removeprefix("*.").rstrip(".")
			try:
				candidate = candidate.encode("idna").decode("ascii")
			except UnicodeError:
				continue
			if candidate == base_domain or not candidate.endswith(f".{base_domain}"):
				continue
			if len(candidate) > 253 or not all(labels.fullmatch(label) for label in candidate.split(".")):
				continue
			subdomains.add(candidate)
	return sorted(subdomains)


def availability(target: dict[str, Any]) -> dict[str, Any]:
	host = target["host"]
	host_for_url = f"[{host}]" if ":" in host else host
	path = target["path"]
	preferred_scheme = target["scheme"] or "https"
	schemes = [preferred_scheme]
	if target["scheme"] is None:
		schemes.append("http")

	last_error = "connection failed"
	for scheme in schemes:
		port = target["port"] or (443 if scheme == "https" else 80)
		default_port = 443 if scheme == "https" else 80
		netloc = host_for_url if port == default_port else f"{host_for_url}:{port}"
		url = f"{scheme}://{netloc}{path}"
		request = urllib.request.Request(url, headers={"User-Agent": f"netcert/{VERSION}"}, method="GET")
		started = time.perf_counter()
		try:
			with urllib.request.urlopen(request, timeout=TIMEOUT_SECONDS) as response:
				return {
					"availability": "UP",
					"http_status": response.status,
					"response_ms": round((time.perf_counter() - started) * 1000),
					"checked_url": url,
				}
		except urllib.error.HTTPError as exc:
			return {
				"availability": "UP",
				"http_status": exc.code,
				"response_ms": round((time.perf_counter() - started) * 1000),
				"checked_url": url,
			}
		except (urllib.error.URLError, TimeoutError, OSError) as exc:
			last_error = str(getattr(exc, "reason", exc))
	return {"availability": "DOWN", "http_status": None, "response_ms": None, "error": last_error}


def certificate_details(der_certificate: bytes) -> dict[str, Any]:
	pem_certificate = ssl.DER_cert_to_PEM_cert(der_certificate)
	details: dict[str, Any] = {"pem": pem_certificate, "not_before": None, "expires": None}
	import tempfile

	with tempfile.NamedTemporaryFile(mode="w", encoding="ascii", suffix=".pem") as temporary:
		temporary.write(pem_certificate)
		temporary.flush()
		decoded = ssl._ssl._test_decode_cert(temporary.name)
	for key, output_key in (("notBefore", "not_before"), ("notAfter", "expires")):
		value = decoded.get(key)
		if value:
			parsed = dt.datetime.strptime(value, "%b %d %H:%M:%S %Y %Z").replace(tzinfo=dt.timezone.utc)
			details[output_key] = parsed.date().isoformat()
	return details


def fetch_certificate(host: str, port: int, verify: bool) -> bytes:
	context = ssl.create_default_context() if verify else ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
	if not verify:
		context.check_hostname = False
		context.verify_mode = ssl.CERT_NONE
	with socket.create_connection((host, port), timeout=TIMEOUT_SECONDS) as raw_socket:
		with context.wrap_socket(raw_socket, server_hostname=host) as tls_socket:
			certificate = tls_socket.getpeercert(binary_form=True)
	if not certificate:
		raise ssl.SSLError("server did not provide a certificate")
	return certificate


def collect_certificate(target: dict[str, Any], store: Path, verify: bool = False) -> dict[str, Any]:
	host = target["host"]
	port = target["port"] or 443
	certificate = fetch_certificate(host, port, verify)
	details = certificate_details(certificate)
	filename_host = host.replace(":", "_")
	certificate_path = store / f"{filename_host}.pem"
	certificate_path.write_text(details.pop("pem"), encoding="ascii")
	now = dt.datetime.now(dt.timezone.utc).date().isoformat()
	not_before = details.get("not_before")
	expires = details.get("expires")
	date_valid = bool(not_before and expires and not_before <= now <= expires)
	return {
		"certificate": str(certificate_path),
		"not_before": not_before,
		"expires": expires,
		"ssl": "VALID" if verify and date_valid else "INVALID" if verify else ("VALID" if date_valid else "EXPIRED/UNKNOWN"),
	}


def certificate_status(host: str, port: int) -> dict[str, Any]:
	try:
		certificate = fetch_certificate(host, port, verify=True)
		verified = True
		verification_error = None
	except (OSError, ssl.SSLError, ValueError) as exc:
		verification_error = str(exc)
		try:
			certificate = fetch_certificate(host, port, verify=False)
			verified = False
		except (OSError, ssl.SSLError, ValueError) as cert_error:
			return {"ssl": "UNAVAILABLE", "ssl_error": str(cert_error)}

	details = certificate_details(certificate)
	now = dt.datetime.now(dt.timezone.utc).date().isoformat()
	not_before = details.get("not_before")
	expires = details.get("expires")
	date_valid = bool(not_before and expires and not_before <= now <= expires)
	result = {
		"ssl": "VALID" if verified and date_valid else "INVALID",
		"not_before": not_before,
		"expires": expires,
	}
	if verification_error:
		result["ssl_error"] = verification_error
	return result


def run_target(mode: str, target: dict[str, Any], store: Path | None) -> dict[str, Any]:
	result: dict[str, Any] = {"target": target["target"]}
	host = target["host"]
	try:
		if mode in ("ip", "ip4", "ip6", "dns", "status"):
			if mode == "dns":
				result.update(dns_information(host))
			else:
				addresses = resolve_addresses(host)
				if mode == "ip4":
					addresses = [address for address in addresses if ipaddress.ip_address(address).version == 4]
				elif mode == "ip6":
					addresses = [address for address in addresses if ipaddress.ip_address(address).version == 6]
				result["addresses"] = addresses
		if mode == "subdomains":
			result["subdomains"] = find_subdomains(host)
			result["source"] = "crt.sh Certificate Transparency logs"
		if mode in ("availability", "status"):
			result.update(availability(target))
		if mode == "ssl":
			assert store is not None
			result.update(collect_certificate(target, store))
		elif mode == "status":
			result.update(certificate_status(host, target["port"] or 443))
	except (OSError, socket.gaierror, ssl.SSLError, ValueError) as exc:
		result["error"] = str(exc)
	return result


def format_text(mode: str, results: list[dict[str, Any]]) -> str:
	output: list[str] = []
	for result in results:
		output.append(result["target"])
		if mode in ("ip", "ip4", "ip6"):
			addresses = result.get("addresses", [])
			ipv4_addresses = [address for address in addresses if ipaddress.ip_address(address).version == 4]
			ipv6_addresses = [address for address in addresses if ipaddress.ip_address(address).version == 6]
			if mode != "ip6":
				output.append("  IPv4:")
				output.extend(f"    {address}" for address in ipv4_addresses)
				if not ipv4_addresses:
					output.append("    (none found)")
			if mode != "ip4":
				output.append("  IPv6:")
				output.extend(f"    {address}" for address in ipv6_addresses)
				if not ipv6_addresses:
					output.append("    (none found)")
		elif mode == "status":
			output.append(f"  IP           : {', '.join(result.get('addresses', [])) or 'Unavailable'}")
		elif mode == "dns":
			output.append(f"  Addresses    : {', '.join(result.get('addresses', [])) or 'Unavailable'}")
			output.append(f"  Canonical    : {result.get('canonical_name') or 'Unavailable'}")
			ptr = result.get("ptr", {})
			output.append(f"  PTR          : {', '.join(f'{ip}={name}' for ip, name in ptr.items()) or 'Unavailable'}")
		elif mode == "subdomains":
			subdomains = result.get("subdomains", [])
			output.append(f"  Subdomains   : {len(subdomains)} found")
			output.extend(f"    {name}" for name in subdomains)
			output.append(f"  Source       : {result.get('source', 'Certificate Transparency logs')}")
		if mode in ("availability", "status"):
			output.append(f"  Availability : {result.get('availability', 'DOWN')}")
			if result.get("http_status") is not None:
				output.append(f"  HTTP Status  : {result['http_status']}")
			if result.get("response_ms") is not None:
				output.append(f"  Response     : {result['response_ms']} ms")
		if mode in ("ssl", "status"):
			output.append(f"  SSL          : {result.get('ssl', 'UNAVAILABLE')}")
			if result.get("expires"):
				output.append(f"  Expires      : {result['expires']}")
			if result.get("certificate"):
				output.append(f"  Certificate  : {result['certificate']}")
		if result.get("error"):
			output.append(f"  Error        : {result['error']}")
		if result.get("ssl_error"):
			output.append(f"  SSL Error    : {result['ssl_error']}")
	return "\n".join(output) + "\n"


CSV_FIELDS = (
	"target",
	"addresses",
	"canonical_name",
	"ptr",
	"subdomains",
	"source",
	"availability",
	"http_status",
	"response_ms",
	"ssl",
	"not_before",
	"expires",
	"certificate",
	"error",
	"ssl_error",
)
IP_CSV_FIELDS = ("URL", "IPv4", "IPv6")


def format_output(mode: str, output_format: str, results: list[dict[str, Any]]) -> str:
	if output_format == "json":
		return json.dumps({"mode": mode, "results": results}, indent=2) + "\n"
	if output_format == "csv":
		from io import StringIO

		stream = StringIO(newline="")
		if mode in ("ip", "ip4", "ip6"):
			writer = csv.DictWriter(stream, fieldnames=IP_CSV_FIELDS, extrasaction="ignore")
			writer.writeheader()
			for result in results:
				addresses = result.get("addresses", [])
				ipv4_addresses = [address for address in addresses if ipaddress.ip_address(address).version == 4]
				ipv6_addresses = [address for address in addresses if ipaddress.ip_address(address).version == 6]
				writer.writerow({
					"URL": result["target"],
					"IPv4": ", ".join(ipv4_addresses),
					"IPv6": ", ".join(ipv6_addresses),
				})
			return stream.getvalue()
		writer = csv.DictWriter(stream, fieldnames=CSV_FIELDS, extrasaction="ignore")
		writer.writeheader()
		for result in results:
			row = dict(result)
			if isinstance(row.get("addresses"), list):
				row["addresses"] = ";".join(row["addresses"])
			if isinstance(row.get("ptr"), dict):
				row["ptr"] = ";".join(f"{ip}={name}" for ip, name in row["ptr"].items())
			if isinstance(row.get("subdomains"), list):
				row["subdomains"] = ";".join(row["subdomains"])
			writer.writerow(row)
		return stream.getvalue()
	return format_text(mode, results)


def target_succeeded(mode: str, result: dict[str, Any]) -> bool:
	return not (
		"error" in result
		or result.get("availability") == "DOWN"
		or (mode == "status" and result.get("ssl") != "VALID")
	)


def main(argv: list[str] | None = None) -> int:
	parser = build_parser()
	args = parser.parse_args(argv)
	if args.ip4 and args.ip6:
		parser.error("--ip4 and --ip6 cannot be combined. Example: netcert -i --ip4 -u example.com")
	other_functions = args.availability or args.dns or args.subdomains or args.ssl or args.status
	if (args.ip4 or args.ip6) and other_functions:
		parser.error("--ip4/--ip6 only apply to IP lookup. Example: netcert -i --ip4 -u example.com")
	if not (args.ip or args.ip4 or args.ip6 or other_functions):
		parser.error("select a function. Example: netcert --ip -u example.com")
	mode = (
		"ip4" if args.ip4 else "ip6" if args.ip6 else "ip" if args.ip
		else "availability" if args.availability else "dns" if args.dns
		else "subdomains" if args.subdomains else "ssl" if args.ssl else "status"
	)
	if args.ssl and not args.store:
		parser.error("--ssl requires --store DIRECTORY")
	if args.summary and not args.ssl:
		parser.error("--summary can only be used with --ssl")
	if args.store and not args.ssl:
		parser.error("--store can only be used with --ssl")

	try:
		targets = read_targets(args)
	except ValueError as exc:
		parser.error(str(exc))

	store: Path | None = None
	if args.ssl:
		store = Path(args.store)
		try:
			store.mkdir(parents=True, exist_ok=True)
		except OSError as exc:
			parser.error(f"cannot create certificate directory {str(store)!r}: {exc}")

	results: list[dict[str, Any]] = []
	success_count = 0
	failed_targets: list[str] = []
	if args.list:
		print(f"0/{len(targets)} success", end="", file=sys.stderr, flush=True)
	for index, target in enumerate(targets, start=1):
		if args.list:
			result = run_target(mode, target, store)
			results.append(result)
			if target_succeeded(mode, result):
				success_count += 1
			else:
				failed_targets.append(target["target"])
			print(f"\r{success_count}/{len(targets)} success", end="", file=sys.stderr, flush=True)
		else:
			print(f"[{index}/{len(targets)}] Checking {target['target']}...", end="", file=sys.stderr, flush=True)
			results.append(run_target(mode, target, store))
			print(" done", file=sys.stderr, flush=True)
	if args.list:
		print(file=sys.stderr)
		if failed_targets:
			print(f"{len(failed_targets)} failed:", file=sys.stderr)
			for failed_target in failed_targets:
				print(failed_target, file=sys.stderr)
	if args.summary:
		assert store is not None
		summary = "".join(
			f"{item['target']} | issued on: {item.get('not_before') or 'unknown'} | expired on: {item.get('expires') or 'unknown'}\n"
			for item in results
		)
		try:
			(store / "summary.txt").write_text(summary, encoding="utf-8")
		except OSError as exc:
			parser.error(f"cannot write certificate summary: {exc}")

	output = format_output(mode, args.output_format or "text", results)
	if args.save is not None:
		default_extension = "json" if args.output_format == "json" else "csv" if args.output_format == "csv" else "txt"
		default_name = f"{mode}.{default_extension}"
		output_path = Path(args.save or default_name)
		try:
			output_path.write_text(output, encoding="utf-8", newline="")
		except OSError as exc:
			parser.error(f"cannot save output to {str(output_path)!r}: {exc}")
	sys.stdout.write(output)
	return 1 if any(not target_succeeded(mode, result) for result in results) else 0


if __name__ == "__main__":
	raise SystemExit(main())
